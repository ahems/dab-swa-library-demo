{
    "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
    "data-source": {
      "database-type": "mssql",
      "options": {
        "set-session-context": false
      },
      "connection-string": "@env('AZURE_SQL_CONNECTION_STRING')"
    },
    "runtime": {
      "rest": {
        "path": "/data-api"
      },
      "graphql": {
        "path": "/data-api/graphql"
      },
      "host": {
        "mode": "production",
        "cors": {
          "origins": [],
          "allow-credentials": true
        },
        "authentication": {
          "provider": "StaticWebApps"
        }
      }
    },
    "entities": {
      "Author": {
        "source": "dbo.authors",
        "permissions": [
          {
            "actions": ["*"],
            "role": "admin"
          },
          {
            "actions": ["read"],
            "role": "anonymous"
          }
        ],
        "relationships": {
          "books": {
            "cardinality": "many",
            "target.entity": "Book"
          }
        }
      },
      "Book": {
        "source": "dbo.books",
        "permissions": [
          {
            "actions": ["*"],
            "role": "admin"
          },
          {
            "actions": ["read"],
            "role": "anonymous"
          }
        ]
      }
    }
  }